# ==============================================================
# Two Players Frontend — Environment Configuration Template
# Copy this file to `frontend/.env` or configure your hosting provider.
# NEVER commit the actual `frontend/.env` file to git.
# ==============================================================

# Port for local static server
PORT=3000

# Public URL of the backend API / Socket.IO server:
# - Leave blank/empty for local WiFi play (auto-connects to current host:5050)
# - Set to full URL if backend is deployed separately:
#   e.g.: BACKEND_URL=https://two-players-backend.up.railway.app
BACKEND_URL=
