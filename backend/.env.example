# ==============================================================
# Two Players Backend — Environment Configuration Template
# Copy this file to `backend/.env` and set your custom values.
# NEVER commit the actual `backend/.env` file to git.
# ==============================================================

# Cryptographic secret key for Flask sessions & security tokens
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server bind host (0.0.0.0 allows connections from devices on the same WiFi/LAN)
HOST=0.0.0.0

# Backend service port
PORT=5050

# Enable/disable debug mode (true/false)
DEBUG=false

# Allowed CORS origins (* for local LAN or comma-separated list of origins for production)
# e.g.: CORS_ORIGINS=http://localhost:3000,http://192.168.1.35:3000
CORS_ORIGINS=*

# Socket.IO concurrency mode (threading, eventlet, or gevent)
SOCKETIO_ASYNC_MODE=threading
